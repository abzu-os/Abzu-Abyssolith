name: Generate ISO
on:
  workflow_dispatch:

jobs:
  iso:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install BlueBuild CLI
        run: |
          curl --proto '=https' --tlsv1.2 -sSf https://blue-build.org/install.sh | bash
          echo "$HOME/.local/bin" >> "$GITHUB_PATH"

      - name: Generate ISO
        run: |
          bluebuild generate-iso \
            --iso-name abzu-abyssolith.iso \
            image ghcr.io/abzu-os/abzu:latest

      - name: Upload ISO artifact
        uses: actions/upload-artifact@v4
        with:
          name: abzu-abyssolith-iso
          path: abzu-abyssolith.iso
          retention-days: 7
